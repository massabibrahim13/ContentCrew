# Copy this file to .env and fill in what you have, then restart the app.
# Everything here is free. Without keys the workflow still runs as far as it
# honestly can, and the Connections list in the workspace shows what's set up.

# --- Server ---------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Storage (defaults shown) ---------------------------------------------
# DATABASE_PATH=data/contentcrew.db
# CHECKPOINT_PATH=data/checkpoints.db
# LOG_DIR=logs

# --- Language model: Groq free tier ---------------------------------------
# Free key, no credit card: https://console.groq.com/keys
# Used for writing, research planning and content-gap analysis.
LLM_PROVIDER=groq
# Groq retired llama-3.3-70b-versatile on 2026-08-16. Free models now: openai/gpt-oss-120b
# (best quality), openai/gpt-oss-20b (faster), qwen/qwen3.8-27b. See console.groq.com/docs/models
LLM_MODEL=openai/gpt-oss-120b
# gpt-oss models "think" before answering. low keeps a run inside the free tier's per-minute
# token limit; medium or high may write better but slower.
# LLM_REASONING_EFFORT=low
GROQ_API_KEY=

# Optional, paid: set LLM_PROVIDER=openai and an OpenAI model in LLM_MODEL instead.
# OPENAI_API_KEY=

# --- Web search: Tavily free plan -----------------------------------------
# Free key, no credit card, 1,000 searches a month: https://app.tavily.com
# Without it, the Analysis Agent reads your competitors' websites directly.
# SEARCH_PROVIDER=serper also works (https://serper.dev, Google results; free credits are one-time).
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# --- Publishing (optional) --------------------------------------------------
# Where the Publish Blog tool sends POST /blog. Leave empty to publish to this
# app's own blog at http://127.0.0.1:<FLASK_PORT>/blog.
# BLOG_API_URL=
