# Copy this file to .env and fill in what you have, then restart the app.
# Everything here is free. Without keys the workflow still runs as far as it
# honestly can, and the Connections list in the workspace shows what's set up.

# --- Server ---------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Storage (defaults shown) ---------------------------------------------
# DATABASE_PATH=data/contentcrew.db
# CHECKPOINT_PATH=data/checkpoints.db
# LOG_DIR=logs

# --- Language model: Groq free tier ---------------------------------------
# Free key, no credit card: https://console.groq.com/keys
# Used for writing, research planning and content-gap analysis.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# --- Web search: Tavily free plan -----------------------------------------
# Free key, no credit card, 1,000 searches a month: https://app.tavily.com
# Without it, the Analysis Agent reads your competitors' websites directly.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
